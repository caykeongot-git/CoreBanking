<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- FIX 1: Đồng bộ version với BLL/DAL (lên .NET 9.0) -->
		<TargetFramework>net9.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- QUAN TRỌNG: Bật WPF để dùng LiveCharts đẹp như HMS -->
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- FIX 2: Thêm NoWarn để tắt cảnh báo tương thích version cũ của LiveCharts -->
		<PackageReference Include="LiveCharts.WinForms" Version="0.9.7" NoWarn="NU1701" />
		<PackageReference Include="LiveCharts.Wpf" Version="0.9.7" NoWarn="NU1701" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CoreBanking.BLL\CoreBanking.BLL.csproj" />
		<ProjectReference Include="..\CoreBanking.DAL\CoreBanking.DAL.csproj" />
	</ItemGroup>

</Project>