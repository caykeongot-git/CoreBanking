<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- Bắt buộc bật WPF để dùng thư viện đồ họa LiveCharts đẹp mượt -->
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CoreBanking.BLL\CoreBanking.BLL.csproj" />
		<ProjectReference Include="..\CoreBanking.DAL\CoreBanking.DAL.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Thư viện Dependency Injection -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />

		<!-- Thư viện LiveCharts (Chuẩn HMS) -->
		<PackageReference Include="LiveCharts.WinForms" Version="0.9.7.1" />
		<PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Forms\" />
	</ItemGroup>

</Project>